FLASK_ENV=development
DATABASE_URL=postgresql://erp_app:PASSWORD@localhost:5432/neondb
JWT_SECRET_KEY=your-secret-key-here

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5002/api/auth/google/callback

APPLE_CLIENT_ID=com.rinosbike.training
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_REDIRECT_URI=http://localhost:5002/api/auth/apple/callback

GITHUB_COPILOT_TOKEN=your-github-copilot-token

# Self-hosted Whisper (speech-to-text captions) — no API key needed
WHISPER_MODEL_SIZE=small

# Self-hosted voice cloning (AI voiceover) — runs in an isolated Python 3.9
# venv (OpenVoice V2's MeloTTS dependency isn't compatible with newer Python)
OPENVOICE_VENV_PYTHON=/path/to/openvoice/venv/bin/python
# Optional — defaults to resources/voiceover_reference_placeholder.wav.
# Override once a real voice recording replaces the placeholder.
# VOICEOVER_REFERENCE_PATH=/path/to/reference-voice.wav

# Cloudflare R2 (same bucket as ERP — different folder: training/)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_IMAGE_BUCKET=rinosbike
R2_IMAGE_PUBLIC_URL=https://pub-81996c30c6f147ddbb2798640787cb53.r2.dev

FRONTEND_URL=http://localhost:3000
